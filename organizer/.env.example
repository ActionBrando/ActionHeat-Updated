# ---- Database (hosted Postgres: Neon / Vercel Postgres / Supabase) ----
# Example (Neon): postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/organizer?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/organizer?sslmode=require"

# ---- Auth (single-user) ----
# Password you type at /login
APP_PASSWORD="change-me-to-something-long"
# Random secret used as the session cookie value. Generate: openssl rand -hex 32
SESSION_SECRET="generate-a-long-random-string"

# ---- AI assistant (Anthropic Claude) ----
ANTHROPIC_API_KEY="sk-ant-..."
# Optional model override. Defaults to claude-opus-4-8.
ANTHROPIC_MODEL="claude-opus-4-8"

# ---- Inbound webhooks (SMS + email) ----
# Shared secret appended to webhook URLs as ?token=...  Generate: openssl rand -hex 24
WEBHOOK_TOKEN="generate-a-webhook-token"

# ---- Twilio (outbound SMS confirmations; inbound needs no creds) ----
# Leave blank to skip sending SMS replies (TwiML reply is still returned).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
